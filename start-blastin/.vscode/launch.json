{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "AttachGodot",
            "type": "coreclr",
            "request": "attach",
            "processId": "${input:findGodotScene}"
        },
        {
            "name": "Run Godot Run",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "godot: build",
            "program":"C:\\Program Files\\Godot\\Godot_v4.5-stable_mono_win64\\Godot_v4.5-stable_mono_win64.exe",
            "cwd":"${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false,
            "args": ["--path","${workspaceRoot}"],
        },
    ],
    "inputs": [
        {
            "id": "findGodotScene",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "powershell -Command \"Get-CimInstance Win32_Process | Where-Object {$_.CommandLine -like '*godot*--scene*'} | Select-Object -ExpandProperty ProcessId\"",
            }
        }
    ]
}