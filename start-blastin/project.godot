; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

resources_spreadsheet_view/array_color_tint=100.0
resources_spreadsheet_view/color_rows=true
resources_spreadsheet_view/array_min_width=128.0
resources_spreadsheet_view/resource_preview_size=32.0
resources_spreadsheet_view/clip_headers=false
resources_spreadsheet_view/dupe_arrays=true
resources_spreadsheet_view/context_menu_on_leftclick=false
resources_spreadsheet_view/fold_docks=true
resources_spreadsheet_view/resource_cell_label_mode=1
resources_spreadsheet_view/freeze_first_column=true

[application]

config/name="Start Blastin"
run/main_scene="uid://die13kk7ig6uu"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://architecture/autoloads/EventBus.cs"
ServiceManager="*res://architecture/services/ServiceManager.cs"
AudioService="*res://architecture/services/AudioService.cs"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="res://logs/godot.log"
file_logging/max_log_files=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Start Blastin"

[editor]

run/main_run_args="--debug-stringnames"

[editor_plugins]

enabled=PackedStringArray("res://addons/AsepriteWizard/plugin.cfg", "res://addons/resources_spreadsheet_view/plugin.cfg", "res://addons/safe_resource_picker/plugin.cfg", "res://addons/subresource_inspector/plugin.cfg")

[file_customization]

folder_colors={
"res://architecture/": "purple",
"res://assets/": "pink",
"res://audio/": "orange",
"res://nodes/": "green",
"res://nodes/player/components/": "purple",
"res://nodes/player/sprites/": "pink",
"res://nodes/ui/hud/assets/": "pink",
"res://resources/": "yellow"
}

[global_group]

projectiles=""
enemy-spawners="Enemy spawners"
level="A level in the game."
enemies=""
players=""
player-ui="Player UIs"
wave-manager="The wave manager. Use this group for debugging."

[gui]

theme/custom="uid://byu0wrnknwnnb"

[importer_defaults]

wav={
"compress/mode": 0,
"edit/loop_begin": 0,
"edit/loop_end": -1,
"edit/loop_mode": 0,
"edit/normalize": false,
"edit/trim": false,
"force/8_bit": false,
"force/max_rate": false,
"force/max_rate_hz": 44100,
"force/mono": false
}

